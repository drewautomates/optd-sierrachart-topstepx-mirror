# Copy to manual_bridge.env (gitignored) and fill in.
# TSX_USER is your TopstepX login name; TSX_API_KEY is the key you generate
# after subscribing to API access in the ProjectX dashboard and linking your
# TopstepX profile (README -> Requirements). Both are only ever read by
# manual_bridge.py. The key can place trades: never commit this file.
TSX_USER=your_topstepx_username
TSX_API_KEY=your_api_key_here
