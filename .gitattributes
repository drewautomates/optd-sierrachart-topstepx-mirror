# Normalize line endings: keep LF in the repo, regardless of OS checkout.
* text=auto eol=lf

# Source / text files — always LF
*.pine   text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.ipynb  text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.sh     text eol=lf
*.ps1    text eol=lf

# Windows batch files MUST keep CRLF. cmd.exe mis-parses multi-line
# if(...) blocks when the file has LF endings.
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Chartbooks are XML but Sierra Chart rewrites them; leave the bytes alone.
*.Cht    binary

# Binary / data files — never touch
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.parquet binary
*.scid   binary
*.zip    binary
